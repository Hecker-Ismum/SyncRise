<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock Top Ears / Bells -->
    <path
        android:pathData="M35,35 L27,27"
        android:strokeColor="#00F0FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M73,35 L81,27"
        android:strokeColor="#00F0FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- Clock Feet -->
    <path
        android:pathData="M36,73 L30,79"
        android:strokeColor="#00F0FF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <path
        android:pathData="M72,73 L78,79"
        android:strokeColor="#00F0FF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Main Alarm Clock Ring -->
    <path
        android:pathData="M54,30 A24,24 0 1,1 53.99,30"
        android:strokeColor="#00F0FF"
        android:strokeWidth="4"
        android:fillColor="#00000000" />

    <!-- Inner Glow/Gradient Mask -->
    <path
        android:pathData="M54,33 A21,21 0 1,1 53.99,33">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="21"
                android:type="radial">
                <item android:color="#3300F0FF" android:offset="0.0" />
                <item android:color="#001E293B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crescent Moon Motif inside Clock (Sleep Side) -->
    <path
        android:pathData="M48,42 A12,12 0 0,0 58,66 A14,14 0 1,1 48,42 Z"
        android:fillColor="#FFFFFF" />

    <!-- Sleep Wave Overlay (Electric Blue) -->
    <path
        android:pathData="M34,54 C40,44 44,64 54,54 C64,44 68,64 74,54"
        android:strokeColor="#3B82F6"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Glowing Center Pivot Dot -->
    <path
        android:pathData="M54,54 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="#00F0FF" />

</vector>